+def _agents_folder(root, addon_id):
+    """The folder with addon.json: the root itself, <root>/<id>/, or the only sub-folder that has one."""
+    for cand in (root, os.path.join(root, addon_id)):
+        if os.path.isfile(os.path.join(cand, "addon.json")):
+            return cand
+    subs = [os.path.join(root, d) for d in sorted(os.listdir(root)) if os.path.isfile(os.path.join(root, d, "addon.json"))]
+    if len(subs) == 1:
+        return subs[0]
+    raise RuntimeError("no addon.json (Vanilla Agents addon) in the source")
+
+
+def _extract_agents_zip(path, dest):
+    """Unpack a submitted Vanilla Agents zip safely (no absolute paths, '..', links, devices; size and count limits)."""
+    with zipfile.ZipFile(path) as z:
+        infos = z.infolist()
+        if len(infos) > AGENTS_MAX_FILES or sum(i.file_size for i in infos) > AGENTS_MAX_UNPACKED:
+            raise RuntimeError("the submitted zip is too big")
+        for i in infos:
+            name = i.filename
+            parts = name.rstrip("/").split("/")
+            mode = i.external_attr >> 16
+            if (name.startswith("/") or "\\" in name or ":" in name or "\x00" in name or any(p in ("", ".", "..") for p in parts)
+                    or (mode and (mode & 0o170000) not in (0, 0o100000, 0o040000)) or i.flag_bits & 0x1):
+                raise RuntimeError(f"unsafe entry in the submitted zip: {name[:80]!r}")
+            if i.is_dir():
+                continue
+            target = os.path.join(dest, *parts)
+            os.makedirs(os.path.dirname(target), exist_ok=True)
+            with z.open(i) as src, open(target, "wb") as out:
+                out.write(src.read(i.file_size + 1)[:i.file_size])
+
+
